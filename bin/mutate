#!/usr/bin/env php
<?php
/**
 * bin/mutate — mutation testing of a plugin's core, judged per file (the platform's RB27 discipline).
 *
 *   bin/mutate                       every file in scope (tests/mutate.php)
 *   bin/mutate --changed[=<ref>]     in-scope files the branch adds or changes against <ref> (default: config `base`, else origin/pre-release)
 *   bin/mutate --path=a,b            those files or folders (plugin-relative)
 *   bin/mutate --advise              runs nothing: whether the branch calls for a run, and the command; exits 0
 *   --update-baseline                after a passing run, raise each floor the run beat; add a new file only at its target
 *   --create-baseline                record every file's score as its first floor (only when there is none)
 *   --report-unbaselined             a file with no floor yet is reported, not failed (gate only what has a floor)
 *   --shard=i/N                      every Nth run of the plan, the ith
 *   --threads=N                      Infection threads (each gets its own kernel database)
 *   --coverage-options="..."         PHP options that turn a coverage driver on (or WP_TEST_KERNEL_COVERAGE_OPTIONS)
 *   --format=text|github|markdown
 *   --mutators=..., --show-mutations inspection: reports, records nothing, exits 3
 *
 * Exit: 0 pass, 1 fail, 3 inspection, 64 usage. Targets: critical path 90; other core 75 overall and 80 covered.
 */

foreach ( array( __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php' ) as $mutate_autoload ) {
	if ( is_readable( $mutate_autoload ) ) {
		require $mutate_autoload;
		break;
	}
}

exit( \Uncanny_Owl\Wp_Test_Kernel\Mutate\Cli::main( $argv ) );
