{
    "name": "uncanny-owl/developer-tools",
    "version": "7.3",
    "description": "Centralized development tools for Uncanny Owl plugins",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Uncanny Automator",
            "email": "support@uncannyautomator.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/string": "^6.0 || ^7.0 || ^8.0",
        "vlucas/phpdotenv": "^5.6",
        "uocs/uncanny-owl-coding-standards": "dev-main",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^13.4",
        "pestphp/pest": "^5.3",
        "infection/infection": "^0.35.8",
        "composer/composer": "^2.9.3",
        "phpbench/phpbench": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Uncanny_Owl\\Wp_Test_Kernel\\": "kernel/src/"
        }
    },
    "config": {
        "sort-packages": false,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true,
            "infection/extension-installer": true
        }
    },
    "bin": [
        "bin/pr-code-check",
        "bin/pr-code-check.bat",
        "bin/pr-code-check.php",
        "bin/scan-hooks.php",
        "bin/enrich-hooks.py",
        "bin/sync-hooks.php",
        "bin/wp-test-kernel",
        "bin/mutate"
    ],
    "scripts": {
        "phpcs": "./vendor/bin/phpcs -s --standard=Uncanny-Automator --warning-severity=1",
        "phpcsOnSave": "./vendor/bin/phpcs -s -v --standard=Uncanny-Automator --warning-severity=1 --report=full",
        "phpcbf": "./vendor/bin/phpcbf -s --standard=Uncanny-Automator",
        "phpcs:pr": "@php bin/pr-code-check.php phpcs",
        "phpcbf:pr": "@php bin/pr-code-check.php phpcbf",
        "crap-score": "@php bin/crap-score.php",
        "crap-score:pr": "@php bin/crap-score.php --pr",
        "phpmd": "./vendor/bin/phpmd . text cleancode,codesize,controversial,design,naming,unusedcode --exclude vendor,tests,node_modules",
        "stamp-version": "@php bin/stamp-version.php",
        "stamp-since": "@php bin/stamp-since.php",
        "lint:integration": "@php bin/lint-integration.php",
        "test:lint": "./vendor/bin/phpunit --no-coverage",
        "test:kernel": "./vendor/bin/phpunit --no-coverage -c kernel/phpunit.xml.dist",
        "post-install-cmd": [
            "@php -r \"file_exists('bin/pr-code-check') && chmod(realpath('bin/pr-code-check'), 0755);\"",
            "@php -r \"file_exists('bin/pr-code-check.php') && chmod(realpath('bin/pr-code-check.php'), 0755);\"",
            "@php -r \"file_exists('bin/stamp-version.php') && chmod(realpath('bin/stamp-version.php'), 0755);\"",
            "@php -r \"file_exists('bin/stamp-since.php') && chmod(realpath('bin/stamp-since.php'), 0755);\""
        ],
        "post-update-cmd": [
            "@php -r \"file_exists('bin/pr-code-check') && chmod(realpath('bin/pr-code-check'), 0755);\"",
            "@php -r \"file_exists('bin/pr-code-check.php') && chmod(realpath('bin/pr-code-check.php'), 0755);\"",
            "@php -r \"file_exists('bin/stamp-version.php') && chmod(realpath('bin/stamp-version.php'), 0755);\"",
            "@php -r \"file_exists('bin/stamp-since.php') && chmod(realpath('bin/stamp-since.php'), 0755);\""
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
