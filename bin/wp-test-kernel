#!/usr/bin/env php
<?php
/**
 * wp-test-kernel — helper commands for running WordPress tests on the Developer-Tools test kernel.
 *
 *   wp-test-kernel attributes <dir|file>... [--static-providers] [--covers [--source=<dir>,...] [--context=<dir>,...]]
 *       Add PHPUnit attributes next to docblock tags (and make data providers public static). --covers
 *       also turns @covers/@coversDefaultClass/@coversNothing into class-level coverage attributes
 *       and removes those docblock lines. A method tag becomes its class (CoversMethod would credit
 *       only that method's lines, not the private helpers it calls); a trait gets CoversTrait.
 *       --source checks every target against what those directories declare: a class_alias()
 *       name becomes its real class, and a target that does not exist, or is an interface, is
 *       kept as a docblock line and reported. --context names directories (an add-on's parent
 *       plugin) read only to follow inheritance: their methods count, their classes are never targets.
 *   wp-test-kernel covers-check <dir|file>... --source=<dir>,... [--context=<dir>,...] [--format=text|github]
 *       Check every test class's coverage attributes against what the source declares, without
 *       running the tests (PHPUnit reports an invalid target only while it collects coverage). Exit 1
 *       on a missing or wrong-kind target, CoversMethod, CoversNothing beside other targets, or a
 *       test class with no coverage attribute.
 *   wp-test-kernel parity --old=<junit.xml> --new=<junit.xml> [--allow=<allowlist.json>] [--format=text|github|markdown]
 *       Compare per-test outcomes of two runs; exit 1 on unexplained differences, 2 when a report cannot be
 *       read or two of its test cases have one id. A test's id is "Ns\Foo_Test::method words [data set]",
 *       with the class's namespace. The allowlist maps ids to the reason they may differ; its "@renamed"
 *       object maps classes in the old report to their new names: "Old_Test" (any namespace, kept),
 *       "Ns\Old_Test" (that class) or "tests/path/Old_Test.php" (that file's test cases, for an old
 *       report that has only short class names) => "New_Test" or "Ns\New_Test".
 *   wp-test-kernel order --from=<junit.xml> --config=<phpunit.xml> --out=<phpunit.order.xml>
 *       Write a PHPUnit config whose test suite lists files in the order the JUnit run executed them.
 */

foreach ( array( __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php' ) as $wp_test_kernel_autoload ) {
	if ( is_readable( $wp_test_kernel_autoload ) ) {
		require $wp_test_kernel_autoload;
		break;
	}
}

use Uncanny_Owl\Wp_Test_Kernel\Tools\Attribute_Adder;
use Uncanny_Owl\Wp_Test_Kernel\Tools\Covers_Check;
use Uncanny_Owl\Wp_Test_Kernel\Tools\Junit_Report;
use Uncanny_Owl\Wp_Test_Kernel\Tools\Source_Index;

/**
 * @param string[] $argv
 *
 * @return array{0: string[], 1: array<string, string|bool>}
 */
function wp_test_kernel_args( array $argv ) {
	$positional = array();
	$options    = array();
	foreach ( array_slice( $argv, 2 ) as $arg ) {
		if ( 0 === strpos( $arg, '--' ) ) {
			$parts                = explode( '=', substr( $arg, 2 ), 2 );
			$options[ $parts[0] ] = $parts[1] ?? true;
			continue;
		}
		$positional[] = $arg;
	}

	return array( $positional, $options );
}

/**
 * @param string[]                   $paths
 * @param array<string, string|bool> $options
 *
 * @return int
 */
function wp_test_kernel_attributes( array $paths, array $options ) {
	$adder   = new Attribute_Adder();
	$changed = 0;
	if ( ! empty( $options['source'] ) && true !== $options['source'] ) {
		$context = empty( $options['context'] ) || true === $options['context'] ? array() : array_filter( explode( ',', (string) $options['context'] ) );
		$adder->use_source_index( Source_Index::build( array_filter( explode( ',', (string) $options['source'] ) ), $context ) );
	}
	$files   = array();

	foreach ( $paths as $path ) {
		if ( is_file( $path ) ) {
			$files[] = $path;
			continue;
		}
		$iterator = new RecursiveIteratorIterator( new RecursiveDirectoryIterator( $path, FilesystemIterator::SKIP_DOTS ) );
		foreach ( $iterator as $file ) {
			if ( 'php' === $file->getExtension() ) {
				$files[] = $file->getPathname();
			}
		}
	}

	sort( $files );
	foreach ( $files as $file ) {
		if ( $adder->process_file( $file, ! empty( $options['static-providers'] ), ! empty( $options['covers'] ) ) ) {
			++$changed;
		}
	}

	ksort( $adder->counts );
	printf( "Files scanned: %d, changed: %d\n", count( $files ), $changed );
	foreach ( $adder->counts as $name => $count ) {
		printf( "  %-26s %d\n", $name, $count );
	}
	foreach ( $adder->notes as $note ) {
		echo '  note: ', $note, PHP_EOL;
	}

	return 0;
}

/**
 * @param array<string, string|bool> $options
 *
 * @return int
 */
function wp_test_kernel_covers_check( array $paths, array $options ) {
	if ( empty( $options['source'] ) || true === $options['source'] ) {
		fwrite( STDERR, "covers-check needs --source=<dir>,...\n" );
		return 2;
	}
	$roots   = array_filter( explode( ',', (string) $options['source'] ) );
	$context = empty( $options['context'] ) || true === $options['context'] ? array() : array_filter( explode( ',', (string) $options['context'] ) );
	$check   = new Covers_Check( Source_Index::build( $roots, $context ), $roots );

	$files = array();
	foreach ( $paths as $path ) {
		if ( is_file( $path ) ) {
			$files[] = $path;
			continue;
		}
		$iterator = new RecursiveIteratorIterator( new RecursiveDirectoryIterator( $path, FilesystemIterator::SKIP_DOTS ) );
		foreach ( $iterator as $file ) {
			if ( 'php' === $file->getExtension() ) {
				$files[] = $file->getPathname();
			}
		}
	}
	sort( $files );
	foreach ( $files as $file ) {
		$check->check_file( $file );
	}

	$github = 'github' === ( $options['format'] ?? 'text' );
	foreach ( $check->problems as $problem ) {
		echo $github
			? sprintf( "::error file=%s,line=%d::%s\n", $problem['file'], $problem['line'], $problem['message'] )
			: sprintf( "%s:%d %s\n", $problem['file'], $problem['line'], $problem['message'] );
	}
	printf( "%d test classes in %d files, %d coverage problems\n", $check->classes, count( $files ), count( $check->problems ) );

	return empty( $check->problems ) ? 0 : 1;
}

function wp_test_kernel_parity( array $options ) {
	if ( empty( $options['old'] ) || empty( $options['new'] ) ) {
		fwrite( STDERR, "parity needs --old=<junit.xml> --new=<junit.xml>\n" );
		return 2;
	}

	$allow = array();
	if ( ! empty( $options['allow'] ) && is_readable( (string) $options['allow'] ) ) {
		$allow = (array) json_decode( (string) file_get_contents( (string) $options['allow'] ), true );
	}
	// "@renamed" (see the header) compares a renamed or moved test class with its old name.
	$renames = (array) ( $allow['@renamed'] ?? array() );
	unset( $allow['@renamed'] );

	try {
		$old = Junit_Report::read( (string) $options['old'], $renames )['tests'];
		$new = Junit_Report::read( (string) $options['new'] )['tests'];
	} catch ( RuntimeException $e ) {
		fwrite( STDERR, $e->getMessage() . "\n" );
		return 2;
	}

	$rows        = array();
	$unexplained = 0;
	foreach ( array_unique( array_merge( array_keys( $old ), array_keys( $new ) ) ) as $id ) {
		$before = $old[ $id ]['outcome'] ?? 'missing';
		$after  = $new[ $id ]['outcome'] ?? 'missing';
		if ( $before === $after ) {
			continue;
		}
		$reason = $allow[ $id ] ?? null;
		if ( null === $reason ) {
			++$unexplained;
		}
		$rows[] = array(
			'id'      => $id,
			'old'     => $before,
			'new'     => $after,
			'reason'  => $reason,
			'file'    => $new[ $id ]['file'] ?? ( $old[ $id ]['file'] ?? '' ),
			'message' => $new[ $id ]['message'] ?? ( $old[ $id ]['message'] ?? '' ),
		);
	}

	$format = (string) ( $options['format'] ?? 'text' );
	$total  = count( array_unique( array_merge( array_keys( $old ), array_keys( $new ) ) ) );

	if ( 'markdown' === $format ) {
		printf( "### Parity: %d tests, %d differences, %d unexplained\n\n", $total, count( $rows ), $unexplained );
		if ( ! empty( $rows ) ) {
			echo "| Test | Old | New | Reason |\n|---|---|---|---|\n";
			foreach ( $rows as $row ) {
				printf( "| `%s` | %s | %s | %s |\n", $row['id'], $row['old'], $row['new'], $row['reason'] ?? '**unexplained** ' . str_replace( '|', '\|', $row['message'] ) );
			}
		}
	} else {
		foreach ( $rows as $row ) {
			if ( 'github' === $format && null === $row['reason'] ) {
				printf( "::error file=%s,title=Parity difference::%s: %s → %s %s\n", $row['file'], $row['id'], $row['old'], $row['new'], $row['message'] );
				continue;
			}
			printf( "%s %s: %s → %s%s\n", null === $row['reason'] ? 'UNEXPLAINED' : 'allowed    ', $row['id'], $row['old'], $row['new'], null === $row['reason'] ? '  ' . $row['message'] : '  (' . $row['reason'] . ')' );
		}
		printf( "%d tests compared, %d differences, %d unexplained\n", $total, count( $rows ), $unexplained );
	}

	return 0 === $unexplained ? 0 : 1;
}

/**
 * @param array<string, string|bool> $options
 *
 * @return int
 */
function wp_test_kernel_order( array $options ) {
	foreach ( array( 'from', 'config', 'out' ) as $required ) {
		if ( empty( $options[ $required ] ) ) {
			fwrite( STDERR, "order needs --from=<junit.xml> --config=<phpunit.xml> --out=<phpunit.order.xml>\n" );
			return 2;
		}
	}

	$files  = Junit_Report::read( (string) $options['from'] )['files'];
	$config = new DOMDocument();
	$config->preserveWhiteSpace = false;
	$config->formatOutput       = true;
	$config->load( (string) $options['config'] );

	$suites = $config->getElementsByTagName( 'testsuites' )->item( 0 );
	while ( $suites && $suites->firstChild ) {
		$suites->removeChild( $suites->firstChild );
	}

	// The ordered suite replaces the config's suites, so a default suite named there would select nothing.
	$config->documentElement->removeAttribute( 'defaultTestSuite' );

	$suite = $config->createElement( 'testsuite' );
	$suite->setAttribute( 'name', 'ordered' );
	$out_dir = dirname( (string) realpath( dirname( (string) $options['out'] ) ) . '/x' );
	foreach ( $files as $file ) {
		$suite->appendChild( $config->createElement( 'file', wp_test_kernel_relative( $out_dir, $file ) ) );
	}
	$suites->appendChild( $suite );

	// The ordered config lives elsewhere: keep its other relative paths pointing where they did.
	$config_dir = dirname( (string) realpath( (string) $options['config'] ) );
	$rebase     = static function ( $path ) use ( $config_dir, $out_dir ) {
		if ( '' === $path || '/' === $path[0] || preg_match( '#^[a-z][a-z0-9+.-]*://#i', $path ) ) {
			return $path;
		}
		return wp_test_kernel_relative( $out_dir, $config_dir . '/' . $path );
	};
	$root = $config->documentElement;
	foreach ( array( 'bootstrap', 'cacheDirectory', 'cacheResultFile', 'xsi:noNamespaceSchemaLocation' ) as $attribute ) {
		if ( $root->hasAttribute( $attribute ) ) {
			$root->setAttribute( $attribute, $rebase( $root->getAttribute( $attribute ) ) );
		}
	}
	foreach ( ( new DOMXPath( $config ) )->query( '//source//directory | //source//file' ) as $node ) {
		$node->nodeValue = $rebase( trim( (string) $node->nodeValue ) );
	}

	$config->save( (string) $options['out'] );
	printf( "Wrote %s with %d files in run order.\n", $options['out'], count( $files ) );

	return 0;
}

/**
 * @param string $from_dir
 * @param string $to_file
 *
 * @return string
 */
function wp_test_kernel_relative( $from_dir, $to_file ) {
	$from = explode( '/', trim( $from_dir, '/' ) );
	$to   = explode( '/', trim( $to_file, '/' ) );
	while ( ! empty( $from ) && ! empty( $to ) && $from[0] === $to[0] ) {
		array_shift( $from );
		array_shift( $to );
	}

	return str_repeat( '../', count( $from ) ) . implode( '/', $to );
}

list( $wp_test_kernel_positional, $wp_test_kernel_options ) = wp_test_kernel_args( $argv );

switch ( $argv[1] ?? '' ) {
	case 'attributes':
		exit( wp_test_kernel_attributes( $wp_test_kernel_positional, $wp_test_kernel_options ) );
	case 'covers-check':
		exit( wp_test_kernel_covers_check( $wp_test_kernel_positional, $wp_test_kernel_options ) );
	case 'parity':
		exit( wp_test_kernel_parity( $wp_test_kernel_options ) );
	case 'order':
		exit( wp_test_kernel_order( $wp_test_kernel_options ) );
	default:
		fwrite( STDERR, "Usage: wp-test-kernel attributes|parity|order (see the header of this file)\n" );
		exit( 2 );
}
