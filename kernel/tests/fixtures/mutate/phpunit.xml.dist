<?xml version="1.0" encoding="UTF-8"?>
<!-- A plugin's PHPUnit config as Automator's: coverage metadata required, risky tests and warnings fail. -->
<phpunit bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="false"
         requireCoverageMetadata="true"
         failOnRisky="true"
         failOnWarning="true">
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory suffix=".php">src</directory>
		</include>
	</source>
</phpunit>
